{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "name": "@hiisi/viola",
  "version": "0.1.0",
  "exports": {
    ".": "./mod.ts",
    "./cli": "./cli.ts",
    "./runtime": "./src/runtime/mod.ts",
    "./linters": "./src/linters/mod.ts",
    "./data": "./src/data/mod.ts",
    "./utils": "./src/utils/mod.ts"
  },
  "tasks": {
    "lint": "deno run -A cli.ts",
    "lint:report": "deno run -A cli.ts --report-only",
    "check": "deno check mod.ts cli.ts"
  },
  "imports": {
    "@std/fs": "jsr:@std/fs@^1",
    "@std/path": "jsr:@std/path@^1",
    "@std/cli": "jsr:@std/cli@^1",
    "@hiisi/flash-freeze": "jsr:@hiisi/flash-freeze@^0.1"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true
  }
}
