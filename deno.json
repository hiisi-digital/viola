{
  "name": "@hiisi/viola",
  "version": "0.3.0-alpha.5",
  "description": "Language-agnostic convention linter runtime. Plugin-based, zero opinions.",
  "exports": {
    ".": "./mod.ts",
    "./config": "./src/config/mod.ts",
    "./runtime": "./src/runtime/mod.ts",
    "./linters": "./src/linters/mod.ts",
    "./data": "./src/data/mod.ts",
    "./utils": "./src/utils/mod.ts",
    "./conditions": "./src/conditions/mod.ts",
    "./grammars": "./src/grammars/mod.ts"
  },
  "publish": {
    "include": [
      "mod.ts",
      "src/**/*.ts",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "src/**/*_test.ts"
    ]
  },
  "imports": {
    "@std/fs": "jsr:@std/fs@^1",
    "@std/path": "jsr:@std/path@^1",
    "@std/assert": "jsr:@std/assert@^1",
    "@hiisi/flash-freeze": "jsr:@hiisi/flash-freeze@0.1.1-alpha.1",
    "web-tree-sitter": "npm:web-tree-sitter@0.22.6",
    "tree-sitter-typescript": "npm:tree-sitter-typescript@0.23.2"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true
  },
  "tasks": {
    "check": "deno check mod.ts",
    "test": "deno test --allow-env --allow-read --allow-write --allow-ffi src/",
    "viola": "deno run -A scripts/viola.ts",
    "viola:strict": "deno run -A scripts/viola.ts --strict"
  },
  "viola": {
    "plugins": [],
    "include": [
      "src"
    ],
    "**/*.ts": {
      "type-location/*": "off",
      "duplicate-strings/*": "warn",
      "*>=major": "error",
      "*>=minor": "warn"
    }
  },
  "minimumDependencyAge": "0"
}
