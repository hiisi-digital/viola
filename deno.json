{
  "name": "@hiisi/viola",
  "version": "0.1.8",
  "exports": {
    ".": "./mod.ts",
    "./config": "./src/config/mod.ts",
    "./runtime": "./src/runtime/mod.ts",
    "./linters": "./src/linters/mod.ts",
    "./data": "./src/data/mod.ts",
    "./utils": "./src/utils/mod.ts",
    "./conditions": "./src/conditions/mod.ts",
    "./grammars": "./src/grammars/mod.ts"
  },
  "publish": {
    "include": [
      "mod.ts",
      "src/**/*.ts",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "src/**/*_test.ts"
    ]
  },
  "imports": {
    "@std/fs": "jsr:@std/fs@^1",
    "@std/path": "jsr:@std/path@^1",
    "@std/assert": "jsr:@std/assert@^1",
    "@hiisi/flash-freeze": "jsr:@hiisi/flash-freeze@^0.1",
    "@hiisi/viola-default-lints": "jsr:@hiisi/viola-default-lints@^0.1",
    "web-tree-sitter": "npm:web-tree-sitter@0.22.6"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true
  },
  "tasks": {
    "check": "deno check mod.ts",
    "test": "deno test src/",
    "viola": "deno run -A scripts/viola.ts",
    "viola:strict": "deno run -A scripts/viola.ts --strict"
  },
  "viola": {
    "plugins": [
      "@hiisi/viola-default-lints"
    ],
    "include": [
      "src"
    ],
    "**/*.ts": {
      "type-location/*": "off",
      "duplicate-strings/*": "warn",
      "*>=major": "error",
      "*>=minor": "warn"
    }
  }
}
